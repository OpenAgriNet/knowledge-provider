# syntax=docker/dockerfile:1
# Production UI: multi-stage Vite build + nginx static host
FROM node:20-alpine AS build

WORKDIR /app
# Force IPv4 for DNS lookups. On hosts where IPv6 is configured on the
# interface but has no real route to the internet, npm's per-package fetches
# each try AAAA first, time out, then fall back to IPv4 — with npm's much
# larger request count (metadata + tarball per package) vs pip, that
# per-request timeout compounds into multi-minute/stalled installs.
ENV NODE_OPTIONS=--dns-result-order=ipv4first
COPY package.json package-lock.json* ./
# Cache mount persists npm's download cache across builds (even cache-busted
# ones); npm ci is faster and reproducible vs npm install when a lockfile exists.
RUN --mount=type=cache,target=/root/.npm \
    if [ -f package-lock.json ]; then npm ci; else npm install; fi

# Explicit copies (not "COPY . .") so this layer never re-touches
# package.json/package-lock.json — doing so after the cache-mounted RUN
# above triggers a known BuildKit/overlay2 "cannot copy to non-directory" bug.
COPY index.html jsconfig.json components.json vite.config.js ./
COPY public ./public
COPY src ./src

# Subpath deploy on registry host
# Keycloak defaults point at the bundled local Keycloak (docker-compose.yml's
# KEYCLOAK_HOST_PORT default 8081, realm/client from keycloak/import/
# docs-pipeline-realm.json) — not the real bharat-vistaar production
# Keycloak. Per PR discussion: localhost for now, pointed at the EC2 demo
# instance's address once that's where this gets shown from.
ARG VITE_API_BASE=/knowledge-provider-api
ARG VITE_KEYCLOAK_URL=http://localhost:8081/auth
ARG VITE_KEYCLOAK_REALM=docs-pipeline
ARG VITE_KEYCLOAK_CLIENT_ID=docs-pipeline-ui
ARG VITE_KEYCLOAK_IDP_HINT=
ARG VITE_AUTH_ENABLED=true
# Feature flag: shows the document validity date fields. Off by default —
# the backend applies validity regardless, this only exposes the entry fields.
ARG VITE_DOCUMENT_VALIDITY_ENABLED=false
ARG VITE_BASE=/knowledge-provider/

ENV VITE_API_BASE=$VITE_API_BASE \
    VITE_KEYCLOAK_URL=$VITE_KEYCLOAK_URL \
    VITE_KEYCLOAK_REALM=$VITE_KEYCLOAK_REALM \
    VITE_KEYCLOAK_CLIENT_ID=$VITE_KEYCLOAK_CLIENT_ID \
    VITE_KEYCLOAK_IDP_HINT=$VITE_KEYCLOAK_IDP_HINT \
    VITE_AUTH_ENABLED=$VITE_AUTH_ENABLED \
    VITE_DOCUMENT_VALIDITY_ENABLED=$VITE_DOCUMENT_VALIDITY_ENABLED

# Vite base path for assets under /knowledge-provider/
RUN npm run build -- --base=${VITE_BASE}

FROM nginx:1.27-alpine

# SPA under /knowledge-provider/ (matches registry nginx alias/proxy)
COPY --from=build /app/dist /usr/share/nginx/html/knowledge-provider
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# Use this file for API and worker settings. See ENV.md for deployment options.

# Database settings for docker-compose.yml. Use a different secret for each role.
# POSTGRES_USER=kp_db_admin  # Bootstrap username for a fresh PostgreSQL volume.
# POSTGRES_PASSWORD=replace-with-a-generated-value  # Bootstrap password only.
# DB_PASSWORD=replace-with-a-generated-value
# TEMPORAL_DB_PASSWORD=replace-with-a-generated-value
# KC_DB_PASSWORD=replace-with-a-generated-value
# KC_ADMIN_PASSWORD=replace-with-a-generated-value
# For a direct deployment, set the external database address and supply authentication separately.
# DATABASE_URL=postgresql://knowledge_provider@localhost:5432/knowledge_provider
# For Temporal outside Compose, set its gRPC endpoint.
# TEMPORAL_HOST=localhost:7233

# Object store. MinIO and AWS use the same S3 adapter.
OBJECT_STORE_TYPE=s3
OBJECT_STORE_ENDPOINT=http://minio:9000  # Compose address; use localhost when running directly.
OBJECT_STORE_BUCKET=documents
OBJECT_STORE_CREDENTIALS_TYPE=static
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=  # Only for temporary credentials.
# Bundled MinIO server bootstrap. Use matching credentials only for a disposable stack.
# MINIO_ROOT_USER=replace-with-a-local-bootstrap-user
# MINIO_ROOT_PASSWORD=replace-with-a-generated-value
# MINIO_BUCKET=documents
# For mounted secrets, set a complete explicit pair. It takes precedence over AWS_*.
# OBJECT_STORE_ACCESS_KEY_ID_FILE=/run/secrets/object-store-access-key
# OBJECT_STORE_SECRET_ACCESS_KEY_FILE=/run/secrets/object-store-secret-key
# Credentials type values: static (above), aws_web_identity (below).
# For AWS workload identity, replace the active type and endpoint:
# OBJECT_STORE_CREDENTIALS_TYPE=aws_web_identity
# OBJECT_STORE_ENDPOINT=https://s3.amazonaws.com
# OBJECT_STORE_REGION=us-east-1
# AWS_ROLE_ARN and AWS_WEB_IDENTITY_TOKEN_FILE can be injected by the platform.
# For Google Cloud Storage replace the active type, bucket, and credentials mode.
# Remove the active OBJECT_STORE_ENDPOINT entry. Attach a Google workload identity
# or mount an ADC configuration file read-only on both the API and the worker.
# OBJECT_STORE_TYPE=gcs
# OBJECT_STORE_BUCKET=knowledge-documents-example
# OBJECT_STORE_CREDENTIALS_TYPE=google_adc
# GOOGLE_CLOUD_PROJECT=example-project
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-adc.json
# OBJECT_STORE_CREATE_BUCKET=false

# Finish all intake at one local search collection, without approval or network publishing.
KP_INDEX_ONLY=true
VECTOR_DB_URL=http://localhost:6333
# Required for bundled Compose Qdrant or an authenticated external service.
# VECTOR_DB_API_KEY=replace-with-a-generated-value
VECTOR_DB_COLLECTION_NAME=documents-index

KEYCLOAK_ISSUER=http://keycloak:8080/auth/realms/knowledge
KEYCLOAK_AUDIENCE=knowledge-provider
KEYCLOAK_CLIENT_ID=knowledge-console
KEYCLOAK_CLIENT_SECRET=
CORS_ORIGINS=http://localhost:3000
# Keycloak runs on the private network and sends email through the realm SMTP settings.
# KC_HOSTNAME=http://keycloak:8080/auth
# KEYCLOAK_EMAIL_OTP_JAR=/absolute/path/to/the-reviewed-authenticator.jar
# KEYCLOAK_CONSOLE_REDIRECT_URI=http://127.0.0.1/knowledge-provider/auth/sso-callback
# VITE_AUTH_ENABLED=true
# Enable the existing Google broker using the console login URL.
# KEYCLOAK_GOOGLE_CONSOLE_URL=https://knowledge.example.org/knowledge-provider/login

# Optional kinds accepted by upload and structured intake.
# DOCUMENT_KINDS=scheme,advisory,video

# Document parser. Start with embedded PDF text.
DOCUMENT_PARSER_TYPE=pypdf
# Alternatives: comment out the active type above and enable one example below.
#
# mock is an alias for the embedded-text reader; use pypdf for new deployments.
# DOCUMENT_PARSER_TYPE=mock
#
# LiteParse; install the lit CLI on the worker.
# DOCUMENT_PARSER_TYPE=liteparse
# DOCUMENT_PARSER_EXECUTABLE=lit
#
# Chandra over vLLM; chandra_vllm is an alias.
# DOCUMENT_PARSER_TYPE=chandra  # Or chandra_vllm.
# DOCUMENT_PARSER_INFERENCE_MODE=vllm
# DOCUMENT_PARSER_ENDPOINT=http://host.docker.internal:8001/v1
# DOCUMENT_PARSER_MODEL=chandra
#
# Mistral OCR; mistral_ocr is an alias.
# DOCUMENT_PARSER_TYPE=mistral  # Or mistral_ocr.
# DOCUMENT_PARSER_API_KEY_FILE=/run/secrets/mistral-api-key
# DOCUMENT_PARSER_MODEL=mistral-ocr-latest
#
# Extension: install the parser plugin before selecting it. No Paddle OCR is bundled.
# DOCUMENT_PARSER_TYPE=extension
# DOCUMENT_PARSER_PLUGIN=my-parser
# DOCUMENT_PARSER_OPTION_MODEL_PATH=/opt/models/my-parser
#
# To offer text and layout profiles instead of a single parser:
# DOCUMENT_PARSER_PROFILES=text,layout
# DOCUMENT_PARSER_DEFAULT=text
# DOCUMENT_PARSER_TEXT_TYPE=pypdf
# DOCUMENT_PARSER_LAYOUT_TYPE=liteparse
# DOCUMENT_PARSER_LAYOUT_EXECUTABLE=lit
# Optional file-format packages installed on both the API and worker.
# DOCUMENT_FORMAT_EXTENSIONS=custom-format

# Translation. Use none to preserve source text and supplied translations.
TRANSLATION_TYPE=none
# For an OpenAI-compatible server such as vLLM, replace TRANSLATION_TYPE above.
# TRANSLATION_TYPE=openai_compatible
# TRANSLATION_BASE_URL=http://127.0.0.1:8020/v1
# TRANSLATION_MODEL=your-model

# Embeddings. The model and dimensions must match on the API and worker.
# local is an alias for sentence_transformers.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_VECTOR_SIZE=384
EMBEDDING_PROMPT_STYLE=e5  # e5, embeddinggemma, or plain.
# Use a separate collection and re-embed all content when changing model or prompt style.
# For an EmbeddingGemma endpoint use EMBEDDING_PROMPT_STYLE=embeddinggemma,
# EMBEDDING_MODEL=google/embeddinggemma-300m and EMBEDDING_VECTOR_SIZE=768
# (or the endpoint’s actual output size).
# To use your own OpenAI-compatible /embeddings endpoint, replace those settings:
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=http://host.docker.internal:8080/v1  # Host model server; set its actual port.
# EMBEDDING_MODEL=intfloat/multilingual-e5-small  # Use the exact model ID your endpoint accepts.
# EMBEDDING_VECTOR_SIZE=384  # Match the actual response dimension.
# EMBEDDING_API_KEY=  # Only if required by the endpoint.
# EMBEDDING_TIMEOUT_SECONDS=120

# To enable network publishing later, first set KP_INDEX_ONLY=false.
# Set the release collection for a managed write target.
# ENABLE_PUBLISH_TO_NETWORK=true
# NETWORK_CONNECTIONS=dev
# NETWORK_CONNECTION_DEFAULT=dev
# NETWORK_CONNECTION_DEV_TYPE=beckn
# NETWORK_CONNECTION_DEV_ID=oan.dev
# NETWORK_CONNECTION_DEV_DISCOVERY_URL=http://discovery-adapter:8080
# NETWORK_CONNECTION_DEV_SENDER_ID=provider.oan.dev
# NETWORK_CONNECTION_DEV_RELEASE_COLLECTION=dev-published
# NETWORK_CONNECTION_DEV_REGISTRY_URL=http://registry:8081
